{
  "name": "book-catalog-backend",
  "version": "1.0.0",
  "description": "Backend for Book Catalog App",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "jest --coverage",
    "test:junit": "JEST_JUNIT_OUTPUT_DIR=reports JEST_JUNIT_OUTPUT_NAME=junit.xml jest --coverage --runInBand --reporters=default --reporters=jest-junit",
    "lint": "eslint src/**/*.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 40,
        "lines": 50,
        "statements": 50
      }
    }
  }
}
