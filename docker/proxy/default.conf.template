# Ce fichier est un template : les variables ${ACTIVE_COLOR},
# ${ACTIVE_BACKEND} et ${ACTIVE_FRONTEND} sont substituees par le
# entrypoint de l'image nginx avant le demarrage.
server {
    listen 80;
    server_name _;

    # Permet au pipeline de verifier vers quelle instance le proxy route.
    add_header X-Active-Color "${ACTIVE_COLOR}" always;

    location /api/ {
        proxy_pass http://${ACTIVE_BACKEND}:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /books {
        proxy_pass http://${ACTIVE_BACKEND}:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://${ACTIVE_FRONTEND}:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
